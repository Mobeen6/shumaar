{
  // Shumaar on Cloudflare Workers: static site + /api/* (Ask and the public data API)
  "name": "shumaar",
  "main": "functions/_lib/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
